scripts/ssotica/dre/**/Temporario/
scripts/ssotica/dre/**/scraper.log

# Saída dos scripts do Ciclone e da Focco (logs, relatórios)
scripts/ciclone/saida/
scripts/focco/saida/
scripts/focco/dre/script_outputs/
scripts/focco/dre/*.log
scripts/focco/dre/execution_report_*.json
